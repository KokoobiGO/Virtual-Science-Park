{
  "name": "virtual-science-park",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:demo-users": "tsx --env-file-if-exists=.env.local scripts/demo-users.ts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:demo-users",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "inngest:dev": "inngest-cli dev -u http://localhost:3000/api/inngest --no-discovery",
    "check:services": "tsx --env-file-if-exists=.env.local scripts/check-services.ts",
    "check:claude": "tsx --env-file-if-exists=.env.local scripts/check-claude.ts",
    "check:nvidia": "tsx --env-file-if-exists=.env.local scripts/check-nvidia.ts",
    "fetch:page": "tsx --env-file-if-exists=.env.local scripts/fetch-page.ts",
    "profile:status": "tsx --env-file-if-exists=.env.local scripts/profile-status.ts",
    "collect": "tsx --env-file-if-exists=.env.local scripts/collect.ts",
    "enrich": "tsx --env-file-if-exists=.env.local scripts/enrich.ts",
    "similar": "tsx --env-file-if-exists=.env.local scripts/similar.ts",
    "match": "tsx --env-file-if-exists=.env.local scripts/match.ts",
    "connections": "tsx --env-file-if-exists=.env.local scripts/connections.ts",
    "trends": "tsx --env-file-if-exists=.env.local scripts/trends.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "gold:export": "tsx --env-file-if-exists=.env.local scripts/gold-export.ts",
    "check:links": "tsx --env-file-if-exists=.env.local scripts/check-links.ts",
    "sources:status": "tsx --env-file-if-exists=.env.local scripts/sources-status.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@base-ui/react": "^1.9.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.26.2",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "inngest-cli": "^1.53.0",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
