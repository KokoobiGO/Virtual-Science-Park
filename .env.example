# Copy to .env.local and fill in. Names only here; real values live in
# .env.local (never committed), Vercel and Inngest.
#
# Local Supabase values come from `npx supabase status` after
# `npm run supabase:start`.

# Claude API. Set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=
# Optional. Leave empty to use https://api.anthropic.com.
ANTHROPIC_API_BASE_URL=

# NVIDIA API: free developer key (nvapi-...) from build.nvidia.com. We test with
# it instead of Claude; npm run check:nvidia tests it.
NVIDIA_API_KEY=
# Optional. Leave empty to use https://integrate.api.nvidia.com/v1.
NVIDIA_API_BASE_URL=
# Optional model overrides. Leave empty for the defaults in lib/nvidia.ts.
NVIDIA_MODEL_FAST=
NVIDIA_MODEL_MAIN=

# Voyage AI embeddings (voyage-4, 1024 dimensions).
VOYAGE_API_KEY=
# Only for keys created in MongoDB Atlas: https://ai.mongodb.com/v1
VOYAGE_BASE_URL=

# Supabase. The publishable key is browser-safe: row-level security applies.
# Legacy projects: the anon key and service-role key work in these same two slots.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side jobs and scripts only. Never in the browser or a Copilot tool.
SUPABASE_SECRET_KEY=
# Drizzle (migrations, jobs). Hosted: the session-pooler connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Inngest. Locally set INNGEST_DEV=1 and run `npm run inngest:dev`.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Resend, for the weekly digest email.
RESEND_API_KEY=

# live, or cached to read stored snapshots instead of live sources.
DEMO_MODE=live
# Search cap per Scout brief. Keep it low enough to finish inside 300 s.
SCOUT_MAX_SEARCHES=8

# Shared password for the four demo accounts (npm run db:demo-users). 12+ characters.
DEMO_USER_PASSWORD=

# Optional: the deployed URL, checked by npm run check:services.
APP_URL=
