# Copy to .env.local and fill in. Names only here; real values live in
# .env.local (never committed), Netlify and Inngest.
#
# Local Supabase values come from `npx supabase status` after
# `npm run supabase:start`. Every name the code reads is listed below.

# --- Database and sign-in (needed for everything) ---------------------------

# Supabase. The publishable key is browser-safe: row-level security applies.
# Legacy projects: the anon key and service-role key work in these same two slots.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side jobs and scripts only (demo users, service checks). Never in the browser or a Copilot tool.
SUPABASE_SECRET_KEY=
# Drizzle (migrations, jobs, scripts). Hosted: the session-pooler connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Shared password for the four demo accounts (npm run db:demo-users). 12+ characters.
DEMO_USER_PASSWORD=

# --- Models (profiler, tagger, judge, trends, connections, Scout, Copilot) --

# NVIDIA API: free developer key (nvapi-...) from build.nvidia.com. The app runs
# on it (decided 2026-11-14); npm run check:nvidia tests it.
NVIDIA_API_KEY=
# Optional. Leave empty to use https://integrate.api.nvidia.com/v1.
NVIDIA_API_BASE_URL=
# Optional model overrides. Leave empty for the defaults in lib/nvidia.ts.
NVIDIA_MODEL_FAST=
NVIDIA_MODEL_MAIN=

# Voyage AI embeddings (voyage-4, 1024 dimensions): enrich, matcher, Scout's store search.
VOYAGE_API_KEY=
# Only for keys created in MongoDB Atlas: https://ai.mongodb.com/v1
VOYAGE_BASE_URL=
# Optional. Leave empty for voyage-4 (lib/voyage.ts).
VOYAGE_MODEL=

# --- Jobs -------------------------------------------------------------------

# Inngest. Locally set INNGEST_DEV=1 and run `npm run inngest:dev`.
# On Netlify leave INNGEST_DEV out and set the two keys.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional. Leave empty for https://api.inngest.com (the staff checks read run results there).
INNGEST_API_BASE_URL=

# --- Email ------------------------------------------------------------------

# Resend, for the weekly digest email (npm run digest, app/digest.requested).
RESEND_API_KEY=

# --- Behaviour --------------------------------------------------------------

# live, or cached to read recorded copies and stored snapshots instead of live sources.
DEMO_MODE=live
# Searches per Scout brief, a whole number from 1 to 20. Empty: 6 (lib/scout/search.ts).
SCOUT_MAX_SEARCHES=

# The deployed site's URL: checked by npm run check:services, and the base of the
# links in the digest email. Empty: http://localhost:3000 for the email links.
APP_URL=

# --- Tests only -------------------------------------------------------------

# Set to 1 to run lib/copilot/classifier.live.test.ts against the real model (needs NVIDIA_API_KEY).
COPILOT_LIVE=
# npm run e2e: the running site to test, default http://localhost:3000. Left
# commented out on purpose: an empty BASE_URL= would replace that default.
# BASE_URL=http://localhost:3000
# npm run e2e: set to 1 to skip the Copilot questions (they make real model calls).
E2E_SKIP_COPILOT=

# --- Leftovers, not used by the app -----------------------------------------

# Claude API. The project owner decided on 2026-11-14 not to use Claude; only
# lib/llm.ts and scripts/check-claude.ts (npm run check:claude) read these.
ANTHROPIC_API_KEY=
# Optional. Leave empty to use https://api.anthropic.com.
ANTHROPIC_API_BASE_URL=
